class SafetyChecker:
    """Pre-flight safety checks to prevent catastrophic failures."""

    @staticmethod
    def verify_no_ghost_mounts(temp_prefix: str = "zypperx_") -> bool:
        """Check for leftover mounts from previous crashes."""
        try:
            with open('/proc/mounts', 'r') as f:
                mounts = f.read()
                if temp_prefix in mounts:
                    console.print(f"[bold red]DANGER:[/bold red] Found leftover mounts from previous run!")
                    console.print("[yellow]Run this command to clean up:[/yellow]")
                    console.print(f"  sudo umount -l /tmp/{temp_prefix}*/chroot/* 2>/dev/null || true")
                    console.print(f"  sudo umount -l /tmp/{temp_prefix}*/chroot 2>/dev/null || true")
                    console.print(f"  sudo rm -rf /tmp/{temp_prefix}*")
                    return False
        except IOError:
            pass
        return True

    @staticmethod
    def verify_filesystem_health() -> bool:
        """Check that critical paths are accessible."""
        critical_paths = ["/var", "/var/cache", "/etc", "/tmp"]
        for path in critical_paths:
            if not os.path.exists(path) or not os.access(path, os.R_OK | os.W_OK):
                console.print(f"[bold red]CRITICAL:[/bold red] {path} is not accessible!")
                return False
        return True

    @staticmethod
    def check_unshare_support() -> bool:
        """Verify that unshare is available and functional."""
        try:
            result = subprocess.run(
                ["unshare", "--version"],
                capture_output=True,
                timeout=2
            )
            return result.returncode == 0
        except (subprocess.TimeoutExpired, FileNotFoundError):
            console.print("[bold red]ERROR:[/bold red] 'unshare' command not found or not working!")
            console.print("Install util-linux package: sudo zypper install util-linux")
            return False


class NamespacedWorker:
    """Isolated worker that runs in its own mount namespace."""

    def __init__(self, worker_id: str, task_type: str, task_item: str):
        self.worker_id = worker_id
        self.task_type = task_type
        self.task_item = task_item
        self.workspace = None

    async def execute(self) -> Tuple[int, str]:
        """Execute task in complete isolation using unshare."""

        self.workspace = tempfile.mkdtemp(prefix=f"zypperx_worker_{self.worker_id}_")

        try:
            if self.task_type == "refresh":
                zypper_args = ["refresh", "--force", self.task_item]
            elif self.task_type == "download":
                zypper_args = ["download", self.task_item]
            else:
                return 1, f"Unknown task type: {self.task_type}"

            cmd = [
                "unshare",
                "--mount",
                "--propagation", "private",
                "sh", "-c",
                self._build_isolated_script(zypper_args)
            ]

            proc = await asyncio.create_subprocess_exec(
                *cmd,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
                env=self._build_env()
            )

            stdout, stderr = await proc.communicate()

            if proc.returncode != 0:
                error_msg = stderr.decode('utf-8', errors='ignore').strip()
                return proc.returncode, error_msg

            return 0, "Success"

        finally:
            # CRITICAL SAFETY: Unmount everything BEFORE rmtree (prevents /var deletion even if isolation fails)
            if self.workspace and os.path.exists(self.workspace):
                chroot_dir = os.path.join(self.workspace, "chroot")
                if os.path.exists(chroot_dir):
                    mount_points = [
                        f"{chroot_dir}/var/cache/zypp",
                        f"{chroot_dir}/var/lib/zypp",
                        f"{chroot_dir}/dev", f"{chroot_dir}/proc", f"{chroot_dir}/sys",
                        f"{chroot_dir}/etc/zypp", f"{chroot_dir}/etc/ssl",
                        f"{chroot_dir}/usr", f"{chroot_dir}/bin", f"{chroot_dir}/sbin",
                        f"{chroot_dir}/lib", f"{chroot_dir}/lib64",
                        f"{chroot_dir}/etc", f"{chroot_dir}/tmp", f"{chroot_dir}/run",
                    ]
                    for mp in mount_points:
                        if os.path.exists(mp):
                            subprocess.run(["umount", "-l", mp], capture_output=True, timeout=5, check=False)
                shutil.rmtree(self.workspace, ignore_errors=True)

    def _build_isolated_script(self, zypper_args: List[str]) -> str:
        """Build shell script that sets up a functional chroot in isolated namespace."""
        script = f"""
set -e

CHROOT="{self.workspace}/chroot"
mkdir -p "$CHROOT"{{/dev,/proc,/sys,/tmp,/run,/var/cache/zypp,/var/lib/zypp,/etc,/usr,/bin,/sbin,/lib,/lib64}}

# Basic mounts
mount -t tmpfs tmpfs "$CHROOT/tmp"
mount -t tmpfs tmpfs "$CHROOT/run"
mount --bind -o ro /dev "$CHROOT/dev"
mount --bind -o ro /proc "$CHROOT/proc"
mount --bind -o ro /sys "$CHROOT/sys"

# Full OS binds so zypper actually works
for dir in /usr /bin /sbin /lib /lib64; do
    if [ -d "$dir" ]; then
        mount --bind -o ro "$dir" "$CHROOT$dir"
    fi
done

# Package cache + metadata (shared read-write)
if [ -d /var/cache/zypp ]; then
    mount --bind /var/cache/zypp "$CHROOT/var/cache/zypp"
fi
if [ -d /var/lib/zypp ]; then
    mount --bind /var/lib/zypp "$CHROOT/var/lib/zypp"
fi

# Network + config (copy to avoid symlink issues)
mkdir -p "$CHROOT/etc"
for f in resolv.conf hosts nsswitch.conf os-release; do
    if [ -e "/etc/$f" ]; then
        cp -L "/etc/$f" "$CHROOT/etc/$f" 2>/dev/null || true
    fi
done

# zypp config and SSL
if [ -d /etc/zypp ]; then
    mkdir -p "$CHROOT/etc/zypp"
    mount --bind -o ro /etc/zypp "$CHROOT/etc/zypp"
fi
if [ -d /etc/ssl ]; then
    mkdir -p "$CHROOT/etc/ssl"
    mount --bind -o ro /etc/ssl "$CHROOT/etc/ssl"
fi

# Run zypper
chroot "$CHROOT" env -i \\
    ZYPP_CURL2=1 \\
    ZYPP_PCK_PRELOAD=1 \\
    ZYPP_SINGLE_RPMTRANS=1 \\
    PATH=/usr/bin:/bin:/sbin \\
    HOME=/tmp \\
    LANG=C.UTF-8 \\
    zypper --non-interactive {' '.join(zypper_args)}
"""
        return script

    def _build_env(self) -> dict:
        return {
            "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
            "HOME": "/tmp",
            "LANG": "C.UTF-8"
        }


class ZypperXEngine:
    def __init__(self, jobs: int = 10, force: bool = False):
        self.jobs = jobs
        self.force = force
        self.lock_fd: Optional[int] = None
        self.sem = asyncio.Semaphore(jobs)
        self.shutting_down = False

    def check_prerequisites(self):
        """Comprehensive safety checks."""
        if os.geteuid() != 0:
            console.print("[bold red]Error:[/bold red] ZypperX must be run as root (sudo).")
            sys.exit(ExitCode.ERROR)

        if not SafetyChecker.verify_no_ghost_mounts():
            sys.exit(ExitCode.ERROR)

        if not SafetyChecker.verify_filesystem_health():
            sys.exit(ExitCode.ERROR)

        if not SafetyChecker.check_unshare_support():
            sys.exit(ExitCode.ERROR)

        required = ["zypper", "mount", "umount", "chroot", "unshare"]
        missing = [prog for prog in required if shutil.which(prog) is None]
        if missing:
            console.print(f"[bold red]Error:[/bold red] Missing system tools: {', '.join(missing)}")
            sys.exit(ExitCode.ERROR)

    def get_lock(self):
        """Acquire exclusive lock using fcntl."""
        try:
            self.lock_fd = os.open(ZYPPER_PID_FILE, os.O_CREAT | os.O_WRONLY, 0o644)
            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.ftruncate(self.lock_fd, 0)
            os.write(self.lock_fd, str(os.getpid()).encode())
        except BlockingIOError:
            try:
                with open(ZYPPER_PID_FILE, 'r') as f:
                    pid = f.read().strip()
                cmd = subprocess.getoutput(f"ps -p {pid} -o comm=") if pid else "unknown"
                console.print(f"[bold red]Error:[/bold red] Zypper is locked by PID {pid} ({cmd}).")
            except Exception:
                console.print("[bold red]Error:[/bold red] Zypper is currently locked.")
            sys.exit(ExitCode.LOCKED)
        except OSError as e:
            console.print(f"[bold red]Error:[/bold red] Could not acquire lock: {e}")
            sys.exit(ExitCode.ERROR)

    def release_lock(self):
        """Release the lock safely."""
        if self.lock_fd is not None:
            try:
                fcntl.flock(self.lock_fd, fcntl.LOCK_UN)
                os.close(self.lock_fd)
                self.lock_fd = None
            except OSError as e:
                log.error(f"Error releasing lock: {e}")

    def validate_input(self, item: str) -> bool:
        """Validate package names and repo aliases."""
        if not re.match(r'^[\w\.\-\+\:]+$', item):
            log.warning(f"Skipping suspicious input: {item}")
            return False
        return True

    async def execute_tasks(self, task_list: List[str], task_type: str, description: str):
        """Execute parallel tasks with isolated workers."""
        valid_tasks = [t for t in task_list if self.validate_input(t)]

        with Progress(
            SpinnerColumn(),
            TextColumn("[bold blue]{task.description}"),
            BarColumn(),
            MofNCompleteColumn(),
            console=console
        ) as progress:

            main_task = progress.add_task(description, total=len(valid_tasks))

            async def worker(idx: int, item: str):
                async with self.sem:
                    w = NamespacedWorker(f"{idx}", task_type, item)
                    try:
                        code, msg = await w.execute()
                        if code != 0:
                            log.error(f"Failed: {item} - {msg}")
                    except Exception as e:
                        log.error(f"Exception for {item}: {e}")
                    finally:
                        progress.advance(main_task)

            await asyncio.gather(*[worker(i, item) for i, item in enumerate(valid_tasks)])

    def get_enabled_repos(self) -> List[str]:
        """Retrieve list of enabled repositories."""
        console.print("[cyan]Scanning enabled repositories...[/cyan]")
        cmd = ["zypper", "--non-interactive", "--no-cd", "--xmlout", "repos"]
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode != 0:
            console.print("[bold red]Failed to list repositories.[/bold red]")
            sys.exit(ExitCode.ERROR)

        try:
            root = ET.fromstring(res.stdout)
            repos = [r.attrib['alias'] for r in root.iter('repo') if r.attrib.get('enabled') == '1']
            return repos
        except ET.ParseError:
            console.print("[bold red]Failed to parse zypper output.[/bold red]")
            sys.exit(ExitCode.ERROR)

    def get_transaction_packages(self, mode: str, packages: List[str] = None) -> Tuple[List[str], int]:
        """Calculate transaction packages using dry-run."""
        console.print(f"[cyan]Calculating transaction for {mode}...[/cyan]")

        base_cmd = ["zypper", "--non-interactive", "--no-cd", "--xmlout"]

        if mode == "dist-upgrade":
            cmd = base_cmd + ["dist-upgrade", "--dry-run"]
        elif mode == "install":
            cmd = base_cmd + ["install", "--dry-run"] + (packages or [])
        elif mode == "install-new-recommends":
            cmd = base_cmd + ["install-new-recommends", "--dry-run"]

        res = subprocess.run(cmd, capture_output=True, text=True)

        if "Nothing to do" in res.stdout:
            return [], 0

        try:
            root = ET.fromstring(res.stdout)
            summary = root.find(".//install-summary")
            if summary is None:
                return [], 0

            download_size = int(summary.attrib.get("download-size", 0))
            to_install = []

            for solv in root.iter("solvable"):
                if solv.attrib.get("type") == "package":
                    pkg_str = f"{solv.attrib['name']}-{solv.attrib['edition']}.{solv.attrib['arch']}"
                    to_install.append(pkg_str)

            final_list = list(set(to_install))
            final_list.sort()
            return final_list, download_size

        except ET.ParseError:
            console.print("[bold red]Failed to parse transaction XML.[/bold red]")
            sys.exit(ExitCode.ERROR)


async def main():
    parser = argparse.ArgumentParser(description="ZypperX v0.0.7-safe - Safe Parallel Accelerator")
    parser.add_argument("-j", "--jobs", type=int, default=10, help="Number of parallel jobs")
    parser.add_argument("-y", "--no-confirm", action="store_true", help="Auto-confirm prompts")
    parser.add_argument("-f", "--force", action="store_true", help="Force refresh")
    parser.add_argument("-d", "--download-only", action="store_true", help="Download only")
    parser.add_argument("--version", action="store_true", help="Show version")

    subparsers = parser.add_subparsers(dest="command")

    p_ref = subparsers.add_parser("refresh", aliases=["ref"])
    p_ref.add_argument("-f", "--force", action="store_true", help="Force refresh")

    p_dup = subparsers.add_parser("dist-upgrade", aliases=["dup"])
    p_dup.add_argument("-d", "--download-only", action="store_true")

    p_in = subparsers.add_parser("install", aliases=["in"])
    p_in.add_argument("packages", nargs="+")
    p_in.add_argument("-d", "--download-only", action="store_true")

    p_inr = subparsers.add_parser("install-new-recommends", aliases=["inr"])
    p_inr.add_argument("-d", "--download-only", action="store_true")

    args = parser.parse_args()

    if args.version:
        console.print(f"[bold cyan]ZypperX {VERSION}[/bold cyan]")
        return

    if not args.command:
        parser.print_help()
        return

    engine = ZypperXEngine(jobs=args.jobs, force=getattr(args, 'force', False))
    engine.check_prerequisites()

    # PHASE 1: Calculate what needs to be done (no lock)
    task_items = []
    mode = ""
    download_only = getattr(args, 'download_only', False)
    no_confirm = getattr(args, 'no_confirm', False)

    if args.command in ["refresh", "ref"]:
        task_items = engine.get_enabled_repos()
        mode = "refresh"
    elif args.command in ["dist-upgrade", "dup", "install", "in", "install-new-recommends", "inr"]:
        mode = "dist-upgrade" if args.command in ["dist-upgrade", "dup"] else \
               "install" if args.command in ["install", "in"] else \
               "install-new-recommends"

        target_pkgs = getattr(args, "packages", [])
        task_items, size = engine.get_transaction_packages(mode, target_pkgs)

        if not task_items:
            console.print("[green]Nothing to do.[/green]")
            return

        if size > 0:
            size_mb = size / (1024 * 1024)
            console.print(Panel(
                f"Packages: [bold]{len(task_items)}[/bold]\nDownload Size: [bold]{size_mb:.2f} MB[/bold]",
                title="Transaction Summary",
                expand=False
            ))

            if not no_confirm:
                if not Confirm.ask("Proceed with download?"):
                    sys.exit(0)
        else:
            console.print("[green]All packages already in cache.[/green]")
            task_items = []

    # PHASE 2: Execute with lock
    if task_items:
        try:
            engine.get_lock()

            if args.command in ["refresh", "ref"]:
                await engine.execute_tasks(task_items, "refresh", "[cyan]Refreshing repos...")
            else:
                await engine.execute_tasks(task_items, "download", "[cyan]Downloading packages...")
        finally:
            engine.release_lock()

    # PHASE 3: Handover to real zypper for installation
    if mode != "refresh" and not download_only:
        console.print("\n[bold yellow]>> Handing over to zypper for installation...[/bold yellow]")
        final_cmd = ["zypper"]
        if no_confirm:
            final_cmd.append("--non-interactive")
        final_cmd.append("--no-cd")

        if mode == "dist-upgrade":
            final_cmd.append("dist-upgrade")
        elif mode == "install-new-recommends":
            final_cmd.append("install-new-recommends")
        elif mode == "install":
            final_cmd.extend(["install"] + getattr(args, "packages", []))

        env = os.environ.copy()
        env.update(ZYPPER_ENV)
        os.execvpe("zypper", final_cmd, env)
    elif mode != "refresh":
        console.print("[bold green]Download complete.[/bold green]")


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        console.print("\n[yellow]Interrupted by user[/yellow]")
        sys.exit(130)
    except Exception as e:
        console.print(f"[bold red]Fatal error:[/bold red] {e}")
        sys.exit(1)
