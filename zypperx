import os
import sys
import asyncio
import shutil
import tempfile
import subprocess
import argparse
import signal
import logging
import fcntl
import re
import xml.etree.ElementTree as ET
from contextlib import asynccontextmanager
from uuid import uuid4
from typing import List, Tuple, Optional, Set
from rich.console import Console
from rich.progress import Progress, SpinnerColumn, BarColumn, TextColumn, MofNCompleteColumn
from rich.logging import RichHandler
from rich.prompt import Confirm
from rich.panel import Panel

# Constants
ZYPPER_PID_FILE = "/run/zypp.pid"
ZYPPER_ENV = {"ZYPP_CURL2": "1", "ZYPP_PCK_PRELOAD": "1", "ZYPP_SINGLE_RPMTRANS": "1"}
VERSION = "0.0.5"

class ExitCode:
    SUCCESS = 0
    ERROR = 1
    LOCKED = 5
    PERMISSION_DENIED = 126

# Setup Rich Console
console = Console()
logging.basicConfig(
    level="INFO",
    format="%(message)s",
    datefmt="[%X]",
    handlers=[RichHandler(console=console, markup=True, show_path=False)]
)
log = logging.getLogger("zypperx")

class ZypperXEngine:
    def __init__(self, jobs: int = 10, force: bool = False):
        self.jobs = jobs
        self.force = force
        self.temp_root: Optional[str] = None
        self.lock_fd: Optional[int] = None
        # Semaphore to control concurrency
        self.sem = asyncio.Semaphore(jobs)
        self.shutting_down = False

    def check_prerequisites(self):
        """Checks for root and system dependencies."""
        if os.geteuid() != 0:
            console.print("[bold red]Error:[/bold red] ZypperX must be run as root (sudo).")
            sys.exit(ExitCode.ERROR)

        # Check dependencies
        required = ["zypper", "mount", "umount", "chroot", "findmnt"]
        missing = [prog for prog in required if shutil.which(prog) is None]
        if missing:
            console.print(f"[bold red]Error:[/bold red] Missing system tools: {', '.join(missing)}")
            sys.exit(ExitCode.ERROR)

    def get_lock(self):
        """Acquire exclusive lock using fcntl (Atomic)."""
        try:
            # Open file for writing, create if not exists
            self.lock_fd = os.open(ZYPPER_PID_FILE, os.O_CREAT | os.O_WRONLY, 0o644)
            # Try to acquire an exclusive lock, non-blocking
            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            # Truncate and write PID
            os.ftruncate(self.lock_fd, 0)
            os.write(self.lock_fd, str(os.getpid()).encode())
        except BlockingIOError:
            # Lock is held by another process
            try:
                with open(ZYPPER_PID_FILE, 'r') as f:
                    pid = f.read().strip()
                cmd = subprocess.getoutput(f"ps -p {pid} -o comm=") if pid and os.path.exists(f"/proc/{pid}") else "unknown"
                console.print(f"[bold red]Error:[/bold red] Zypper is currently locked by PID {pid} ({cmd}).")
            except Exception:
                console.print("[bold red]Error:[/bold red] Zypper is currently locked.")
            sys.exit(ExitCode.LOCKED)
        except OSError as e:
            console.print(f"[bold red]Error:[/bold red] Could not acquire lock: {e}")
            sys.exit(ExitCode.ERROR)

    def release_lock(self):
        """Release the lock safely."""
        if self.lock_fd is not None:
            try:
                fcntl.flock(self.lock_fd, fcntl.LOCK_UN)
                os.close(self.lock_fd)
                self.lock_fd = None
            except OSError as e:
                log.error(f"Error releasing lock: {e}")

    def setup_signal_handlers(self):
        """Setup graceful shutdown for SIGINT/SIGTERM."""
        def signal_handler(signum, frame):
            if self.shutting_down:
                return
            self.shutting_down = True
            log.warning("\n[bold yellow]Received signal, cleaning up...[/bold yellow]")
            asyncio.create_task(self.cleanup())
            sys.exit(ExitCode.ERROR)

        signal.signal(signal.SIGTERM, signal_handler)
        signal.signal(signal.SIGINT, signal_handler)

    @asynccontextmanager
    async def safe_environment(self):
        """Context Manager for the temporary workspace."""
        self.setup_signal_handlers()
        self.temp_root = tempfile.mkdtemp(prefix="zypperx_")
        log.debug(f"Workspace: {self.temp_root}")

        try:
            # Acquire lock ONLY when we are ready to download
            self.get_lock()
            yield self.temp_root
        finally:
            await self.cleanup()

    def get_mounts_under(self, path: str) -> List[str]:
        """Get all mounts under a path efficiently reading /proc/mounts."""
        mounts = []
        try:
            with open('/proc/mounts', 'r') as f:
                for line in f:
                    parts = line.split()
                    if len(parts) >= 2:
                        mount_point = parts[1]
                        if mount_point.startswith(path):
                            mounts.append(mount_point)
        except IOError as e:
            log.error(f"Failed to read /proc/mounts: {e}")
        return sorted(mounts, reverse=True)

    async def cleanup(self):
        """Aggressive cleanup of mounts and temp files."""
        if self.temp_root and os.path.exists(self.temp_root):
            log.debug("Cleaning up resources...")
            mounts = self.get_mounts_under(self.temp_root)
            for mount in mounts:
                subprocess.run(
                    ['umount', '-l', mount],
                    stderr=subprocess.DEVNULL,
                    check=False
                )
            try:
                shutil.rmtree(self.temp_root, ignore_errors=True)
            except Exception as e:
                log.error(f"Failed to remove temp dir: {e}")

        self.release_lock()

    async def cleanup_worker(self, worker_root: str):
        """Specific cleanup for a single worker path."""
        mounts = self.get_mounts_under(worker_root)
        for mount in mounts:
            subprocess.run(['umount', '-l', mount], stderr=subprocess.DEVNULL, check=False)

    async def mount_with_retry(self, src: str, dest: str, flags: List[str], max_retries: int = 3):
        """Mount with retry logic, handling files and directories correctly."""
        # Ensure mount point exists (create file if src is file, dir if src is dir)
        if src.startswith("/") and os.path.exists(src):
            if os.path.isfile(src):
                # For file bind mounts, ensure parent dir exists and create empty file
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                if not os.path.exists(dest):
                    open(dest, 'a').close()
            else:
                # For directory mounts
                os.makedirs(dest, exist_ok=True)
        else:
            # For tmpfs and other virtual filesystems
            os.makedirs(dest, exist_ok=True)

        for attempt in range(max_retries):
            cmd = ["mount"] + flags + [src, dest]
            result = subprocess.run(cmd, capture_output=True, text=True)
            if result.returncode == 0:
                return True
            if attempt < max_retries - 1:
                await asyncio.sleep(0.1 * (attempt + 1))

        log.error(f"Failed to mount {src} to {dest}: {result.stderr.strip()}")
        return False

    async def prepare_chroot(self, worker_uuid: str) -> str:
        """Creates a functional chroot environment with proper networking."""
        worker_root = os.path.join(self.temp_root, worker_uuid, "rootfs")

        # 1. Create Base Directory Structure
        for d in ["run", "tmp", "dev", "proc", "sys", "var/cache/zypp", "var/lib/ca-certificates", "etc"]:
            os.makedirs(os.path.join(worker_root, d), exist_ok=True)

        # 2. Mount List - Ordered for proper layering
        mounts = [
            # Core Filesystem (Read-Only Host Root)
            ("/", worker_root, ["--bind", "-o", "ro"]),

            # Kernel API Filesystems (Required for network tools)
            ("/dev", os.path.join(worker_root, "dev"), ["--bind"]),
            ("/proc", os.path.join(worker_root, "proc"), ["--bind"]),
            ("/sys", os.path.join(worker_root, "sys"), ["--bind"]),

            # Isolated Runtime (CRITICAL: Empty tmpfs hides host /run/zypp.pid)
            ("tmpfs", os.path.join(worker_root, "run"), ["-t", "tmpfs", "-o", "mode=755,size=10m"]),

            # Writeable Temporary Space
            ("tmpfs", os.path.join(worker_root, "tmp"), ["-t", "tmpfs", "-o", "mode=1777,size=100m"]),

            # Shared Package Cache (Read-Write for downloads)
            ("/var", os.path.join(worker_root, "var"), ["--bind"]),
            ("/var/cache/zypp", os.path.join(worker_root, "var/cache/zypp"), ["--bind"]),

            # Network Configuration (Bind mount ensures DNS works)
            ("/etc/resolv.conf", os.path.join(worker_root, "etc/resolv.conf"), ["--bind", "-o", "ro"]),

            # SSL/TLS Certificates (Required for HTTPS repo access)
            ("/etc/ssl", os.path.join(worker_root, "etc/ssl"), ["--bind", "-o", "ro"]),
            ("/var/lib/ca-certificates", os.path.join(worker_root, "var/lib/ca-certificates"), ["--bind", "-o", "ro"]),
        ]

        # 3. Optional Mounts (Only if they exist on host)
        optional_mounts = [
            ("/etc/hosts", os.path.join(worker_root, "etc/hosts"), ["--bind", "-o", "ro"]),
            ("/etc/nsswitch.conf", os.path.join(worker_root, "etc/nsswitch.conf"), ["--bind", "-o", "ro"]),
        ]

        # 4. Execute Core Mounts
        for src, dest, flags in mounts:
            # Skip missing sources (except tmpfs which is virtual)
            if src.startswith("/") and not os.path.exists(src):
                log.warning(f"Skipping missing mount source: {src}")
                continue

            if not await self.mount_with_retry(src, dest, flags):
                raise RuntimeError(f"Critical mount failed: {src}")

        # 5. Execute Optional Mounts (non-fatal)
        for src, dest, flags in optional_mounts:
            if os.path.exists(src):
                await self.mount_with_retry(src, dest, flags)

        return worker_root

    async def _run_zypper_in_chroot(self, chroot_path: str, args: List[str]) -> Tuple[int, bytes, bytes]:
        """Helper to run the command inside the chroot."""
        cmd = ["chroot", chroot_path, "env", "-i"]
        for k, v in ZYPPER_ENV.items():
            cmd.append(f"{k}={v}")
        cmd.extend(["zypper", "--non-interactive"] + args)

        proc = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        stdout, stderr = await proc.communicate()
        return proc.returncode, stdout, stderr

    def validate_input(self, item: str) -> bool:
        """Validate package names and repo aliases to prevent injection."""
        if not re.match(r'^[\w\.\-\+\:]+$', item):
            log.warning(f"Skipping suspicious input item: {item}")
            return False
        return True

    async def execute_tasks(self, task_list: List[str], task_type: str, description: str):
        """Execute parallel tasks with progress tracking."""
        valid_tasks = [t for t in task_list if self.validate_input(t)]

        with Progress(
            SpinnerColumn(),
            TextColumn("[bold blue]{task.description}"),
            BarColumn(),
            MofNCompleteColumn(),
            console=console
        ) as progress:

            main_task = progress.add_task(description, total=len(valid_tasks))

            async def worker(item):
                async with self.sem:
                    worker_uuid = str(uuid4())
                    root_path = None
                    try:
                        root_path = await self.prepare_chroot(worker_uuid)

                        if task_type == "refresh":
                            cmd_args = ["refresh", "--force"] if self.force else ["refresh"]
                            cmd_args.append(item)
                        elif task_type == "download":
                            cmd_args = ["download", item]

                        code, out, err = await self._run_zypper_in_chroot(root_path, cmd_args)

                        if code != 0:
                            error_msg = err.decode('utf-8', errors='ignore').strip()
                            log.error(f"Failed to process {item}. Code: {code}")
                            if error_msg:
                                log.debug(f"Error details: {error_msg}")
                    except Exception as e:
                        log.error(f"Exception in worker for {item}: {e}")
                    finally:
                        progress.advance(main_task)
                        if root_path:
                            await self.cleanup_worker(root_path)

            await asyncio.gather(*[worker(item) for item in valid_tasks])

    def get_enabled_repos(self) -> List[str]:
        """Retrieve list of enabled repositories."""
        console.print("[cyan]Scanning enabled repositories...[/cyan]")
        cmd = ["env", "-i"] + [f"{k}={v}" for k,v in ZYPPER_ENV.items()] + \
              ["zypper", "--non-interactive", "--no-cd", "--xmlout", "repos"]

        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode != 0:
            console.print("[bold red]Failed to list repositories.[/bold red]")
            sys.exit(ExitCode.ERROR)

        try:
            root = ET.fromstring(res.stdout)
            repos = [r.attrib['alias'] for r in root.iter('repo') if r.attrib.get('enabled') == '1']
            return repos
        except ET.ParseError:
            console.print("[bold red]Failed to parse zypper output.[/bold red]")
            sys.exit(ExitCode.ERROR)

    def get_transaction_packages(self, mode: str, packages: List[str] = None) -> Tuple[List[str], int]:
        """Calculate transaction packages using dry-run."""
        console.print(f"[cyan]Calculating transaction for {mode}...[/cyan]")

        base_cmd = ["env", "-i"] + [f"{k}={v}" for k,v in ZYPPER_ENV.items()] + \
                   ["zypper", "--non-interactive", "--no-cd", "--xmlout"]

        if mode == "dist-upgrade":
            cmd = base_cmd + ["dist-upgrade", "--dry-run"]
        elif mode == "install":
            cmd = base_cmd + ["install", "--dry-run"] + (packages or [])
        elif mode == "install-new-recommends":
            cmd = base_cmd + ["install-new-recommends", "--dry-run"]

        res = subprocess.run(cmd, capture_output=True, text=True)

        if "Nothing to do" in res.stdout or (res.returncode == 0 and "install-summary" not in res.stdout):
             return [], 0

        try:
            root = ET.fromstring(res.stdout)
            summary = root.find(".//install-summary")
            if summary is None:
                msgs = [m.text for m in root.iter("message") if m.text]
                if msgs:
                    console.print(Panel("\n".join(msgs), title="Zypper Solver Message", border_style="yellow"))
                return [], 0

            download_size = int(summary.attrib.get("download-size", 0))
            to_install = []
            for solv in root.iter("solvable"):
                if solv.attrib.get("type") == "package":
                    pkg_str = f"{solv.attrib['name']}-{solv.attrib['edition']}.{solv.attrib['arch']}"
                    to_install.append(pkg_str)

            to_remove = []
            for rm in root.iter("to-remove"):
                for solv in rm.findall("solvable"):
                     to_remove.append(f"{solv.attrib['name']}-{solv.attrib['edition']}.{solv.attrib['arch']}")

            final_list = list(set(to_install) - set(to_remove))
            final_list.sort()
            return final_list, download_size

        except ET.ParseError:
            console.print("[bold red]Failed to parse transaction XML.[/bold red]")
            sys.exit(ExitCode.ERROR)


async def main():
    parser = argparse.ArgumentParser(description="ZypperX - Parallel Accelerator for Zypper")
    parser.add_argument("-j", "--jobs", type=int, default=10, help="Number of parallel jobs")
    parser.add_argument("-y", "--no-confirm", action="store_true", help="Auto-confirm prompts")
    parser.add_argument("-f", "--force", action="store_true", help="Force refresh")
    parser.add_argument("-d", "--download-only", action="store_true", help="Download only")
    parser.add_argument("--version", action="store_true", help="Show version")

    subparsers = parser.add_subparsers(dest="command")

    p_ref = subparsers.add_parser("refresh", aliases=["ref"])
    p_ref.add_argument("-f", "--force", action="store_true", help="Force refresh")

    p_dup = subparsers.add_parser("dist-upgrade", aliases=["dup"])
    p_dup.add_argument("-d", "--download-only", action="store_true")

    p_in = subparsers.add_parser("install", aliases=["in"])
    p_in.add_argument("packages", nargs="+")
    p_in.add_argument("-d", "--download-only", action="store_true")

    p_inr = subparsers.add_parser("install-new-recommends", aliases=["inr"])
    p_inr.add_argument("-d", "--download-only", action="store_true")

    args = parser.parse_args()

    if args.version:
        console.print(f"ZypperX v{VERSION}")
        return

    if not args.command:
        parser.print_help()
        return

    engine = ZypperXEngine(jobs=args.jobs, force=getattr(args, 'force', False))
    engine.check_prerequisites()

    # PHASE 1: Calculation (No lock yet!)
    # We must do this BEFORE taking the lock, otherwise zypper dry-run fails.
    task_items = []
    mode = ""
    download_only = getattr(args, 'download_only', False)
    no_confirm = getattr(args, 'no_confirm', False)

    if args.command in ["refresh", "ref"]:
        task_items = engine.get_enabled_repos()
        mode = "refresh"
    elif args.command in ["dist-upgrade", "dup", "install", "in", "install-new-recommends", "inr"]:
        mode = "dist-upgrade" if args.command in ["dist-upgrade", "dup"] else \
               "install" if args.command in ["install", "in"] else \
               "install-new-recommends"

        target_pkgs = getattr(args, "packages", [])
        task_items, size = engine.get_transaction_packages(mode, target_pkgs)

        if not task_items:
            if size == 0:
                console.print("[green]Nothing to do.[/green]")
            return

        if size > 0:
            size_mb = size / (1024 * 1024)
            console.print(Panel(
                f"Packages: [bold]{len(task_items)}[/bold]\nDownload Size: [bold]{size_mb:.2f} MB[/bold]",
                title="Transaction Summary",
                expand=False
            ))

            if not no_confirm:
                if not Confirm.ask("Proceed with download?"):
                    sys.exit(0)
        else:
            console.print("[green]All packages already in cache.[/green]")
            task_items = [] # Skip download phase

    # PHASE 2: Parallel Execution (Lock Held)
    if task_items:
        async with engine.safe_environment():
            if args.command in ["refresh", "ref"]:
                 await engine.execute_tasks(task_items, "refresh", "[cyan]Refreshing repos...")
            else:
                 await engine.execute_tasks(task_items, "download", "[cyan]Downloading packages...")

    # PHASE 3: Handover
    if mode != "refresh" and not download_only:
        console.print("\n[bold yellow]>> Handing over to actual Zypper for installation...[/bold yellow]")
        final_cmd = ["zypper"]
        if no_confirm: final_cmd.append("--non-interactive")
        final_cmd.append("--no-cd")

        if mode == "dist-upgrade": final_cmd.append("dist-upgrade")
        elif mode == "install-new-recommends": final_cmd.append("install-new-recommends")
        elif mode == "install": final_cmd.extend(["install"] + getattr(args, "packages", []))

        # Ensure lock is released before passing control
        engine.release_lock()

        env = os.environ.copy()
        env.update(ZYPPER_ENV)
        os.execvpe("zypper", final_cmd, env)
    elif mode != "refresh":
        console.print("[bold green]Download complete.[/bold green]")

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pass
